# Variáveis de ambiente do protótipo TFD. Copie para .env.local e preencha.
# Nunca coloque NEXT_PUBLIC_ nas chaves abaixo: elas ficam só no servidor.

# Supabase (já usadas pelo protótipo)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Assistente de Relatórios (/relatorios?aba=assistente)
# JEV (TypeSafe System One): classifica o relatório pedido, risco e confiança.
# Chave em https://typesafe.ai (painel da conta > API keys).
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# Gemini: extrai período, filtros e agrupamento em JSON estruturado.
# Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.5-flash-lite não é mais liberado para contas novas (404).
GEMINI_MODEL=gemini-3.5-flash-lite
