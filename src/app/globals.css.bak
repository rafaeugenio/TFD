@import "tailwindcss";
@import "../styles/variables.css";

/* ============================================================
   Tailwind v4 Theme — TFD / PrimeNG Aura Tokens
   ============================================================ */

@theme inline {
  /* --- Font families --- */
  --font-sans: var(--tfd-font-family);
  --font-mono: var(--tfd-font-mono);

  /* --- Font sizes (PrimeNG scale) --- */
  --font-size-xs:   0.75rem;
  --font-size-sm:   0.875rem;
  --font-size-base: 1rem;
  --font-size-lg:   1.125rem;
  --font-size-xl:   1.25rem;
  --font-size-2xl:  1.5rem;
  --font-size-3xl:  1.875rem;

  /* --- Primary --- */
  --color-tfd-primary-50:  var(--tfd-primary-50);
  --color-tfd-primary-100: var(--tfd-primary-100);
  --color-tfd-primary-200: var(--tfd-primary-200);
  --color-tfd-primary-300: var(--tfd-primary-300);
  --color-tfd-primary-400: var(--tfd-primary-400);
  --color-tfd-primary-500: var(--tfd-primary-500);
  --color-tfd-primary-600: var(--tfd-primary-600);
  --color-tfd-primary-700: var(--tfd-primary-700);
  --color-tfd-primary-800: var(--tfd-primary-800);
  --color-tfd-primary-900: var(--tfd-primary-900);

  /* --- Secondary --- */
  --color-tfd-secondary-50:  var(--tfd-secondary-50);
  --color-tfd-secondary-100: var(--tfd-secondary-100);
  --color-tfd-secondary-200: var(--tfd-secondary-200);
  --color-tfd-secondary-300: var(--tfd-secondary-300);
  --color-tfd-secondary-400: var(--tfd-secondary-400);
  --color-tfd-secondary-500: var(--tfd-secondary-500);
  --color-tfd-secondary-600: var(--tfd-secondary-600);
  --color-tfd-secondary-700: var(--tfd-secondary-700);
  --color-tfd-secondary-800: var(--tfd-secondary-800);
  --color-tfd-secondary-900: var(--tfd-secondary-900);

  /* --- Surface (Aura full scale) --- */
  --color-tfd-surface-0:   var(--tfd-surface-0);
  --color-tfd-surface-50:  var(--tfd-surface-50);
  --color-tfd-surface-100: var(--tfd-surface-100);
  --color-tfd-surface-200: var(--tfd-surface-200);
  --color-tfd-surface-300: var(--tfd-surface-300);
  --color-tfd-surface-400: var(--tfd-surface-400);
  --color-tfd-surface-500: var(--tfd-surface-500);
  --color-tfd-surface-600: var(--tfd-surface-600);
  --color-tfd-surface-700: var(--tfd-surface-700);
  --color-tfd-surface-800: var(--tfd-surface-800);
  --color-tfd-surface-900: var(--tfd-surface-900);
  --color-tfd-surface-950: var(--tfd-surface-950);

  /* --- Aliases --- */
  --color-tfd-surface-ground:  var(--tfd-surface-ground);
  --color-tfd-surface-card:    var(--tfd-surface-card);
  --color-tfd-surface-sidebar: var(--tfd-surface-sidebar);
  --color-tfd-surface-header:  var(--tfd-surface-header);
  --color-tfd-surface-border:  var(--tfd-surface-border);
  --color-tfd-surface-hover:   var(--tfd-surface-hover);

  /* --- Text --- */
  --color-tfd-text-primary:    var(--tfd-text-primary);
  --color-tfd-text-secondary:  var(--tfd-text-secondary);
  --color-tfd-text-muted:      var(--tfd-text-muted);
  --color-tfd-text-on-dark:    var(--tfd-text-on-dark);
  --color-tfd-text-on-primary: var(--tfd-text-on-primary);

  /* --- Status --- */
  --color-tfd-status-success:    var(--tfd-status-success);
  --color-tfd-status-success-bg: var(--tfd-status-success-bg);
  --color-tfd-status-warning:    var(--tfd-status-warning);
  --color-tfd-status-warning-bg: var(--tfd-status-warning-bg);
  --color-tfd-status-danger:     var(--tfd-status-danger);
  --color-tfd-status-danger-bg:  var(--tfd-status-danger-bg);
  --color-tfd-status-info:       var(--tfd-status-info);
  --color-tfd-status-info-bg:    var(--tfd-status-info-bg);

  /* --- Border Radius --- */
  --radius-none: var(--tfd-radius-none);
  --radius-xs:   var(--tfd-radius-xs);
  --radius-sm:   var(--tfd-radius-sm);
  --radius-md:   var(--tfd-radius-md);
  --radius-lg:   var(--tfd-radius-lg);
  --radius-xl:   var(--tfd-radius-xl);
  --radius-pill: var(--tfd-radius-pill);

  /* --- Shadows --- */
  --shadow-form:    var(--tfd-shadow-form);
  --shadow-sm:      var(--tfd-shadow-sm);
  --shadow-card:    var(--tfd-shadow-card);
  --shadow-overlay: var(--tfd-shadow-overlay);
  --shadow-modal:   var(--tfd-shadow-modal);

  /* --- Breakpoints --- */
  --breakpoint-sm: 640px;
  --breakpoint-md: 768px;
  --breakpoint-lg: 1024px;
  --breakpoint-xl: 1280px;
}

/* ============================================================
   Base styles — PrimeNG Aura
   ============================================================ */

body {
  font-family: var(--tfd-font-family);
  font-feature-settings: var(--tfd-font-features);
  background-color: var(--tfd-surface-ground);
  color: var(--tfd-text-primary);
  line-height: var(--tfd-body-lh);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ============================================================
   Component Classes — PrimeNG Aura fidelity
   ============================================================ */

/* ─── CARD ─────────────────────────────────────────────────── */
/* Tokens: bg white, radius 12px, shadow card, padding 1.25rem */

.tfd-card {
  background-color: var(--tfd-surface-card);
  border: 1px solid var(--tfd-surface-border);
  border-radius: var(--tfd-radius-xl);
  box-shadow: var(--tfd-shadow-card);
  padding: 1.25rem;
}

.tfd-card-title {
  font-size: 1.25rem;
  font-weight: 500;
  color: var(--tfd-text-primary);
  margin: 0 0 0.5rem;
}

.tfd-card-subtitle {
  font-size: var(--tfd-font-sm);
  color: var(--tfd-surface-500);
  margin: 0;
}

/* ─── PANEL ────────────────────────────────────────────────── */
/* Tokens: header 1rem 1.25rem, content 1.25rem, border surface-200, radius 12px */

.tfd-panel {
  background-color: var(--tfd-surface-card);
  border: 1px solid var(--tfd-surface-border);
  border-radius: var(--tfd-radius-xl);
}

.tfd-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 1.25rem;
  font-weight: 600;
  font-size: var(--tfd-font-md);
  color: var(--tfd-text-primary);
  border-bottom: 1px solid var(--tfd-surface-border);
}

.tfd-panel-content {
  padding: 1.25rem;
}

/* ─── TOOLBAR ──────────────────────────────────────────────── */
/* Tokens: padding 0.75rem 1rem, border surface-200, radius 12px, bg surface-0 */

.tfd-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  padding: 0.75rem 1rem;
  background-color: var(--tfd-surface-card);
  border: 1px solid var(--tfd-surface-border);
  border-radius: var(--tfd-radius-xl);
}

/* ─── INPUT ────────────────────────────────────────────────── */
/* Tokens: border 1px surface-300, radius 6px, shadow form, padding md */

.tfd-input {
  display: block;
  width: 100%;
  border: 1px solid var(--tfd-form-border-color);
  border-radius: var(--tfd-radius-md);
  box-shadow: var(--tfd-shadow-form);
  padding: var(--tfd-form-py-md) var(--tfd-form-px-md);
  font-size: var(--tfd-font-md);
  color: var(--tfd-form-color);
  background-color: var(--tfd-form-bg);
  transition: var(--tfd-transition-all);
}

.tfd-input::placeholder { color: var(--tfd-form-placeholder); }

.tfd-input:focus {
  outline: none;
  border-color: var(--tfd-form-focus-border);
  box-shadow: 0 0 0 var(--tfd-focus-ring-offset) var(--tfd-surface-card),
              0 0 0 calc(var(--tfd-focus-ring-offset) + var(--tfd-focus-ring-width)) var(--tfd-focus-ring-color);
}

.tfd-input:disabled {
  opacity: var(--tfd-opacity-disabled);
  cursor: not-allowed;
  background-color: var(--tfd-form-disabled-bg);
}

.tfd-input--invalid {
  border-color: var(--tfd-form-invalid-border);
}

.tfd-input--sm {
  font-size: var(--tfd-font-sm);
  padding: var(--tfd-form-py-sm) var(--tfd-form-px-sm);
}

.tfd-input--lg {
  font-size: var(--tfd-font-lg);
  padding: var(--tfd-form-py-lg) var(--tfd-form-px-lg);
}

.tfd-input--filled {
  background-color: var(--tfd-form-filled-bg);
  border-color: transparent;
}

/* ─── FORM LABEL ───────────────────────────────────────────── */

.tfd-label {
  display: block;
  font-size: var(--tfd-font-sm);
  font-weight: 500;
  color: var(--tfd-text-primary);
  margin-bottom: 0.25rem;
}

.tfd-field-error {
  font-size: 0.75rem;
  color: var(--tfd-status-danger);
  margin-top: 0.25rem;
}

/* ─── BUTTONS (PrimeNG Aura — all severities + variants) ──── */
/* Base: radius 6px, gap 0.5rem, transition 0.2s, focus 1px/2px */

.tfd-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  font-size: var(--tfd-font-md);
  font-weight: 500;
  line-height: 1.25;
  padding: var(--tfd-form-py-md) var(--tfd-form-px-md);
  border: 1px solid transparent;
  border-radius: var(--tfd-radius-md);
  cursor: pointer;
  transition: var(--tfd-transition-all);
  white-space: nowrap;
}

.tfd-btn:focus-visible {
  outline: none;
  box-shadow: 0 0 0 var(--tfd-focus-ring-offset) var(--tfd-surface-card),
              0 0 0 calc(var(--tfd-focus-ring-offset) + var(--tfd-focus-ring-width)) var(--tfd-focus-ring-color);
}

.tfd-btn:disabled {
  opacity: var(--tfd-opacity-disabled);
  cursor: not-allowed;
  pointer-events: none;
}

/* Size variants */
.tfd-btn--sm {
  font-size: var(--tfd-font-sm);
  padding: var(--tfd-form-py-sm) var(--tfd-form-px-sm);
}

.tfd-btn--lg {
  font-size: var(--tfd-font-lg);
  padding: var(--tfd-form-py-lg) var(--tfd-form-px-lg);
}

/* Shape variants */
.tfd-btn--rounded { border-radius: var(--tfd-radius-pill); }
.tfd-btn--icon-only { padding: var(--tfd-form-py-md); aspect-ratio: 1; }
.tfd-btn--fluid { width: 100%; }

/* ── Severity: Primary (default filled) ── */
.tfd-btn-primary {
  background-color: var(--tfd-primary-500);
  color: var(--tfd-text-on-primary);
  border-color: var(--tfd-primary-500);
}
.tfd-btn-primary:hover { background-color: var(--tfd-primary-600); border-color: var(--tfd-primary-600); }
.tfd-btn-primary:active { background-color: var(--tfd-primary-700); border-color: var(--tfd-primary-700); }

/* ── Severity: Secondary (outlined) ── */
.tfd-btn-secondary {
  background-color: transparent;
  color: var(--tfd-surface-600);
  border-color: var(--tfd-surface-200);
}
.tfd-btn-secondary:hover { background-color: var(--tfd-surface-100); color: var(--tfd-surface-700); }
.tfd-btn-secondary:active { background-color: var(--tfd-surface-200); }

/* ── Severity: Success ── */
.tfd-btn-success {
  background-color: var(--tfd-status-success);
  color: var(--tfd-text-on-primary);
  border-color: var(--tfd-status-success);
}
.tfd-btn-success:hover { background-color: var(--tfd-secondary-700); border-color: var(--tfd-secondary-700); }

/* ── Severity: Danger ── */
.tfd-btn-danger {
  background-color: var(--tfd-status-danger);
  color: var(--tfd-text-on-primary);
  border-color: var(--tfd-status-danger);
}
.tfd-btn-danger:hover { filter: brightness(0.9); }

/* ── Severity: Info ── */
.tfd-btn-info {
  background-color: var(--tfd-status-info);
  color: var(--tfd-text-on-primary);
  border-color: var(--tfd-status-info);
}
.tfd-btn-info:hover { filter: brightness(0.9); }

/* ── Severity: Warning ── */
.tfd-btn-warn {
  background-color: var(--tfd-status-warning);
  color: var(--tfd-text-primary);
  border-color: var(--tfd-status-warning);
}
.tfd-btn-warn:hover { filter: brightness(0.9); }

/* ── Severity: Contrast (alto contraste) ── */
.tfd-btn-contrast {
  background-color: var(--tfd-surface-900);
  color: var(--tfd-surface-0);
  border-color: var(--tfd-surface-900);
}
.tfd-btn-contrast:hover { background-color: var(--tfd-surface-800); border-color: var(--tfd-surface-800); }

/* ── Variant: Outlined (qualquer severity) ── */
.tfd-btn--outlined {
  background-color: transparent;
}
.tfd-btn--outlined.tfd-btn-primary { color: var(--tfd-primary-500); border-color: var(--tfd-primary-500); }
.tfd-btn--outlined.tfd-btn-primary:hover { background-color: var(--tfd-primary-50); }
.tfd-btn--outlined.tfd-btn-success { color: var(--tfd-status-success); border-color: var(--tfd-status-success); }
.tfd-btn--outlined.tfd-btn-success:hover { background-color: var(--tfd-secondary-50); }
.tfd-btn--outlined.tfd-btn-danger { color: var(--tfd-status-danger); border-color: var(--tfd-status-danger); }
.tfd-btn--outlined.tfd-btn-danger:hover { background-color: var(--tfd-status-danger-bg); }

/* ── Variant: Text (sem fundo, sem borda) ── */
.tfd-btn--text {
  background-color: transparent;
  border-color: transparent;
}
.tfd-btn--text.tfd-btn-primary { color: var(--tfd-primary-500); }
.tfd-btn--text.tfd-btn-primary:hover { background-color: var(--tfd-primary-50); }
.tfd-btn--text.tfd-btn-danger { color: var(--tfd-status-danger); }
.tfd-btn--text.tfd-btn-danger:hover { background-color: var(--tfd-status-danger-bg); }
.tfd-btn--text.tfd-btn-secondary { color: var(--tfd-surface-600); }
.tfd-btn--text.tfd-btn-secondary:hover { background-color: var(--tfd-surface-100); }

/* ─── TABLE (PrimeNG Aura DataTable) ──────────────────────── */
/* Tokens: header bg surface-50, cell padding 0.75rem 1rem, border surface-200 */

.tfd-table {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--tfd-font-sm);
}

.tfd-table thead th {
  background-color: var(--tfd-surface-50);
  padding: 0.75rem 1rem;
  text-align: left;
  font-weight: 600;
  font-size: var(--tfd-font-sm);
  color: var(--tfd-text-secondary);
  border-bottom: 1px solid var(--tfd-surface-border);
  white-space: nowrap;
}

.tfd-table tbody td {
  padding: 0.75rem 1rem;
  color: var(--tfd-text-primary);
  border-bottom: 1px solid var(--tfd-surface-border);
  vertical-align: middle;
}

.tfd-table tbody tr {
  transition: background-color var(--tfd-transition-duration) var(--tfd-transition-timing);
}

.tfd-table tbody tr:hover {
  background-color: var(--tfd-surface-hover);
}

/* Striped variant */
.tfd-table--striped tbody tr:nth-child(even) {
  background-color: var(--tfd-surface-50);
}

/* Gridlines variant */
.tfd-table--gridlines th,
.tfd-table--gridlines td {
  border: 1px solid var(--tfd-surface-border);
}

/* Size variants */
.tfd-table--sm th,
.tfd-table--sm td {
  padding: 0.5rem 0.75rem;
  font-size: 0.75rem;
}

/* ─── TAG (PrimeNG Aura severities) ───────────────────────── */
/* Tokens: padding 0.25rem 0.5rem, font 0.75rem/700, radius 6px (or pill) */

.tfd-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.25rem 0.625rem;
  font-size: 0.75rem;
  font-weight: 700;
  border-radius: var(--tfd-radius-md);
  white-space: nowrap;
}

.tfd-tag--rounded { border-radius: var(--tfd-radius-pill); }

.tfd-tag--success { background-color: #DCFCE7; color: #15803D; }
.tfd-tag--danger  { background-color: #FEE2E2; color: #B91C1C; }
.tfd-tag--warn    { background-color: #FEF3C7; color: #92400E; }
.tfd-tag--info    { background-color: #DBEAFE; color: #1D4ED8; }
.tfd-tag--secondary { background-color: var(--tfd-surface-100); color: var(--tfd-surface-700); }

/* Tag with dot indicator (status-style) */
.tfd-tag--dot::before {
  content: "";
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: currentColor;
  flex-shrink: 0;
}

/* ─── BADGE ────────────────────────────────────────────────── */
/* Tokens: min-width 1.25rem, height 1.25rem, font 0.6875rem/700, radius pill */

.tfd-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 0.6875rem;
  font-weight: 700;
  line-height: 1;
  min-width: 1.25rem;
  height: 1.25rem;
  padding: 0 0.375rem;
  border-radius: var(--tfd-radius-pill);
  background-color: var(--tfd-primary-500);
  color: var(--tfd-text-on-primary);
}

.tfd-badge--success { background-color: var(--tfd-status-success); }
.tfd-badge--warning { background-color: var(--tfd-status-warning); color: var(--tfd-text-primary); }
.tfd-badge--danger  { background-color: var(--tfd-status-danger); }
.tfd-badge--info    { background-color: var(--tfd-status-info); }
.tfd-badge--secondary { background-color: var(--tfd-surface-200); color: var(--tfd-surface-700); }

/* Dot (sem numero) */
.tfd-badge--dot {
  min-width: 0.5rem;
  width: 0.5rem;
  height: 0.5rem;
  padding: 0;
}

/* ─── AVATAR ───────────────────────────────────────────────── */
/* Tokens: default 2rem, large 3rem, xlarge 4rem, radius 6px or circle */

.tfd-avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  font-size: var(--tfd-font-sm);
  font-weight: 600;
  border-radius: var(--tfd-radius-md);
  background-color: var(--tfd-primary-500);
  color: var(--tfd-text-on-primary);
  overflow: hidden;
  flex-shrink: 0;
}

.tfd-avatar--circle { border-radius: 50%; }
.tfd-avatar--lg { width: 3rem; height: 3rem; font-size: var(--tfd-font-md); }
.tfd-avatar--xl { width: 4rem; height: 4rem; font-size: var(--tfd-font-lg); }

.tfd-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ─── CHIP ─────────────────────────────────────────────────── */
/* Tokens: padding 0.25rem 0.75rem, height 1.75rem, radius pill, font 0.875rem */

.tfd-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.25rem 0.75rem;
  height: 1.75rem;
  font-size: var(--tfd-font-sm);
  border-radius: var(--tfd-radius-pill);
  background-color: var(--tfd-surface-100);
  border: 1px solid var(--tfd-surface-200);
  color: var(--tfd-text-primary);
}

/* ─── MESSAGE (Inline — PrimeNG Aura) ─────────────────────── */
/* Tokens: radius 6px, padding 0.75rem 1rem, border-left 3px solid */

.tfd-message {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  padding: 0.75rem 1rem;
  border-radius: var(--tfd-radius-md);
  border-left: 3px solid;
  font-size: var(--tfd-font-sm);
}

.tfd-message-icon { font-size: 1rem; flex-shrink: 0; margin-top: 1px; }

.tfd-message--success { background-color: var(--tfd-status-success-bg); border-color: var(--tfd-status-success); }
.tfd-message--success .tfd-message-icon { color: var(--tfd-status-success); }

.tfd-message--warn { background-color: var(--tfd-status-warning-bg); border-color: var(--tfd-status-warning); }
.tfd-message--warn .tfd-message-icon { color: var(--tfd-status-warning); }

.tfd-message--danger { background-color: var(--tfd-status-danger-bg); border-color: var(--tfd-status-danger); }
.tfd-message--danger .tfd-message-icon { color: var(--tfd-status-danger); }

.tfd-message--info { background-color: var(--tfd-status-info-bg); border-color: var(--tfd-status-info); }
.tfd-message--info .tfd-message-icon { color: var(--tfd-status-info); }

/* ─── DIVIDER ──────────────────────────────────────────────── */

.tfd-divider {
  border: none;
  border-top: 1px solid var(--tfd-surface-border);
  margin: 1rem 0;
}

.tfd-divider--dashed { border-top-style: dashed; }
.tfd-divider--dotted { border-top-style: dotted; }

/* ─── PROGRESS BAR ─────────────────────────────────────────── */
/* Tokens: height 1.25rem, radius 6px, fill primary, track surface-200 */

.tfd-progressbar {
  width: 100%;
  height: 1.25rem;
  border-radius: var(--tfd-radius-md);
  background-color: var(--tfd-surface-200);
  overflow: hidden;
}

.tfd-progressbar-fill {
  height: 100%;
  border-radius: var(--tfd-radius-md);
  background-color: var(--tfd-primary-500);
  transition: width var(--tfd-transition-duration) var(--tfd-transition-timing);
}

.tfd-progressbar--thin {
  height: 4px;
}

/* ─── TOOLTIP ──────────────────────────────────────────────── */
/* Tokens: bg surface-700, color white, radius 6px, padding 0.5rem 0.75rem, font 0.875rem */

.tfd-tooltip {
  background-color: var(--tfd-surface-700);
  color: white;
  border-radius: var(--tfd-radius-md);
  padding: 0.5rem 0.75rem;
  font-size: var(--tfd-font-sm);
  max-width: 12.5rem;
  box-shadow: var(--tfd-shadow-overlay);
  pointer-events: none;
  z-index: 60;
}

/* ─── DIALOG / OVERLAY ─────────────────────────────────────── */
/* Tokens: radius 12px, padding 1.25rem, shadow modal, backdrop rgba(0,0,0,0.4) */

.tfd-overlay-backdrop {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 50;
  transition: opacity 0.15s;
}

.tfd-dialog {
  background-color: var(--tfd-surface-card);
  border: 1px solid var(--tfd-surface-border);
  border-radius: var(--tfd-radius-xl);
  box-shadow: var(--tfd-shadow-modal);
  overflow: hidden;
}

.tfd-dialog-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.25rem 1.25rem 0;
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--tfd-text-primary);
}

.tfd-dialog-content {
  padding: 1.25rem;
}

.tfd-dialog-footer {
  display: flex;
  justify-content: flex-end;
  gap: 0.5rem;
  padding: 0 1.25rem 1.25rem;
}

/* ─── SCROLLBAR ────────────────────────────────────────────── */

::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--tfd-surface-300); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: var(--tfd-surface-400); }
